# PRODUKSI WAJIB: APP_ENV=production dan APP_DEBUG=false.
# APP_DEBUG=true membocorkan stack trace, query SQL, path server, dan secret
# environment (mis. APP_KEY/token integrasi) ke pengguna saat terjadi error.
# Setelah mengubah .env di server, jalankan: php artisan config:cache
APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
# MON-02 (produksi): pakai 'daily' (rotasi) + 'slack' untuk alert, mis. LOG_STACK=daily,slack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# PRODUKSI: LOG_LEVEL=warning (kurangi noise; 'debug' hanya untuk lokal)
LOG_LEVEL=debug
LOG_DAILY_DAYS=30

# MON-01 — Alerting. Isi webhook agar error/critical (termasuk monitor:health)
# terkirim ke Slack. Tambahkan 'slack' ke LOG_STACK di atas BERSAMAAN dengan ini.
LOG_SLACK_WEBHOOK_URL=
LOG_SLACK_LEVEL=critical
# Error tracking (opsional): composer require sentry/sentry-laravel lalu isi DSN.
# SENTRY_LARAVEL_DSN=
# Direktori backup DB (BR-01) — pantauan kesegaran backup oleh monitor:health.
# DB_BACKUP_PATH=/var/backups/sikeren

# MON-03 — Observability kesehatan sistem (endpoint /health + monitor:health).
# Token untuk melihat detail per-probe di /health; tanpa token hanya status
# agregat (aman untuk monitor uptime publik). Kosong = detail dimatikan.
MONITORING_HEALTH_TOKEN=
# Ambang probe (opsional; nilai default di kurung):
# MONITORING_DISK_MIN_PCT=15            # sisa disk % → warn
# MONITORING_DISK_CRIT_PCT=5            # sisa disk % → critical
# MONITORING_QUEUE_BACKLOG_MINUTES=15   # umur job antrian tertua → warn
# MONITORING_SCHEDULER_STALE_MINUTES=5  # basi heartbeat scheduler → warn (cron mati)
# MONITORING_BACKUP_STALE_HOURS=26      # umur backup → warn
# MONITORING_ERROR_RATE_MAX=25          # error/critical pada ~128KB log terbaru → warn
# MONITORING_FAILED_JOBS_CRIT=100       # failed_jobs ≥ nilai ini → critical
# Cek keterjangkauan integrasi eksternal (opsional): aktifkan via IntegrationSetting
# monitoring.check_integrations=true + monitoring.endpoints=[{"name":"WA","url":"https://..."}]

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=maxton
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
# PRODUKSI: pertimbangkan SESSION_ENCRYPT=true untuk mengenkripsi isi sesi.
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# PRODUKSI WAJIB (situs HTTPS): cookie sesi hanya dikirim lewat koneksi terenkripsi
# agar tidak bisa dicuri di jaringan (session hijacking akun bendahara/KPA).
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Kompresi PDF saat upload (mis. file kontrak mitra) via Ghostscript.
# Bila Ghostscript tidak terpasang, file ASLI tetap disimpan (upload tidak gagal).
# GHOSTSCRIPT_BINARY kosong = auto-detect (PATH + lokasi umum Windows/Linux).
# Install Windows: https://ghostscript.com/releases/gsdnld.html
#   contoh path: "C:\Program Files\gs\gs10.04.0\bin\gswin64c.exe"
# Install Linux: apt-get install ghostscript
PDF_COMPRESSION_ENABLED=true
GHOSTSCRIPT_BINARY=
PDF_COMPRESSION_PRESET=/ebook

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# WhatsApp Notification (Fonnte SaaS)
FONNTE_TOKEN=

# WhatsApp Gateway self-hosted (header X-API-Key)
# Endpoint yang ditembak: {WA_GATEWAY_URL}/api/v1/messages/send
WA_GATEWAY_URL=
WA_API_KEY=
WA_DEVICE_ID=
